{
  "name": "flipdocs",
  "version": "0.2.0",
  "description": "Fast React PDF and image flipbooks with a real Three.js page curl.",
  "keywords": [
    "flipbook",
    "page-flip",
    "page-turn",
    "pdf",
    "pdf-viewer",
    "react",
    "three",
    "threejs",
    "webgl",
    "book"
  ],
  "author": "Eliezer Berenbaum",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/eliart20/flipdocs.git"
  },
  "homepage": "https://github.com/eliart20/flipdocs#readme",
  "bugs": {
    "url": "https://github.com/eliart20/flipdocs/issues"
  },
  "type": "module",
  "sideEffects": [
    "**/*.css"
  ],
  "main": "./dist/flipdocs.js",
  "module": "./dist/flipdocs.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/flipdocs.js"
    },
    "./style.css": "./dist/flipdocs.css"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "dev": "node scripts/copy-pdf-worker.mjs public && vite",
    "build": "npm run clean && vite build && tsc -p tsconfig.lib.json && node scripts/copy-pdf-worker.mjs",
    "audit": "node scripts/audit-package.mjs",
    "clean": "node -e \"fs.rmSync('dist', { recursive: true, force: true })\"",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "preview": "vite preview",
    "prepare": "npm run build",
    "prepublishOnly": "npm run typecheck && npm run test && npm run build"
  },
  "peerDependencies": {
    "react": ">=18.0.0",
    "react-dom": ">=18.0.0"
  },
  "dependencies": {
    "pdfjs-dist": "5.5.207",
    "three": "^0.179.1"
  },
  "devDependencies": {
    "@types/node": "^26.2.0",
    "@types/react": "^19.1.10",
    "@types/react-dom": "^19.1.7",
    "@types/three": "^0.179.0",
    "@vitejs/plugin-react": "^5.0.2",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "typescript": "^5.9.2",
    "vite": "^7.1.3",
    "vitest": "^3.2.4"
  },
  "license": "MIT"
}
